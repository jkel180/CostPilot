# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Supabase > Connect > Connection string, with the psycopg driver prefix.
# URL-encode special characters in the password (e.g. ! -> %21).
# Direct connection (IPv6):  postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Session pooler (IPv4):     postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy HS256 JWT secret; leave empty with asymmetric signing keys.
SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:3000"]

# CostPilot operators who manage shared market data (comma-separated emails)
PLATFORM_ADMIN_EMAILS=
# Shared secret for the scheduled Eurostat import (GitHub Actions); empty disables it
INGESTION_TOKEN=
